NEXT_PUBLIC_SITE_URL=https://www.ubuntulocationbtp.com
# Dossier hors public/, sur un disque persistant. Par défaut : ./data
RENTX_DATA_DIR=./data
# true uniquement si votre reverse proxy écrase X-Forwarded-For.
RENTX_TRUST_PROXY=false
# Facultatif : validation Google Search Console
GOOGLE_SITE_VERIFICATION=
# URL chargée par les apps natives (Android/iOS/Desktop). Vide = apps.config.ts (production).
RENTX_APP_URL=
# Exemple de test local : RENTX_APP_URL=http://localhost:3000
