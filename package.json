{
  "name": "rentx-next",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "test": "node --import tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "build:webpack": "next build --webpack",
    "account": "node --import tsx scripts/accounts.ts",
    "db:backup": "node --import tsx scripts/backup.ts",
    "db:import": "node --import tsx scripts/import-catalogue.ts",
    "test:e2e": "playwright test",
    "build:turbopack": "next build",
    "app:sync": "npx cap sync && npx cap sync @capawesome/capacitor-electron",
    "app:open:android": "npx cap open android",
    "app:open:ios": "npx cap open ios",
    "app:run:android": "npx cap run android",
    "app:run:ios": "npx cap run ios",
    "app:run:desktop": "npx cap run @capawesome/capacitor-electron",
    "app:apk": "scripts/android-gradle.sh assembleDebug",
    "app:apk:release": "scripts/android-gradle.sh assembleRelease",
    "app:aab": "scripts/android-gradle.sh bundleRelease",
    "app:desktop:pack": "cd electron && npm run pack",
    "postinstall": "cd electron && npm ci"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "@capawesome/capacitor-electron": "^0.2.2",
    "better-sqlite3": "13.0.3",
    "clsx": "^2.1.1",
    "next": "16.3.3",
    "next-sitemap": "^4.2.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "^0.35.4",
    "swiper": "^14.2.0",
    "tailwind-merge": "^3.6.0",
    "tsx": "4.23.13",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "^20.19.43",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
